# Spotify release radar configuration.
# Copy this file to .env and fill in real values; never commit .env.

# --- Telegram ---------------------------------------------------------
# Create a bot with @BotFather. This MUST be a different token from the iTunes
# bot: two processes long-polling with one token both get 409 Conflict, and every
# command silently breaks until the duplicate is stopped.
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# --- Spotify ----------------------------------------------------------
# Client ID from the Spotify developer dashboard. This is public, not secret.
SPOTIFY_CLIENT_ID=YOUR_CLIENT_ID_HERE

# Client secret from the same dashboard. Authentication uses only the
# client-credentials grant, so this value replaces the old user refresh token:
# the bot never signs in as a Spotify account and never stores a refresh token.
# Treat it like a password, and never send it in Telegram, screenshots or chat.
SPOTIFY_CLIENT_SECRET=YOUR_CLIENT_SECRET_HERE

# Everything else has a working default and can stay commented out. See
# README.md for the full list.
# SCAN_TIME is not configurable: the scan always runs at 05:35 IST.
# CHAT_ID is not configured: alerts go to the admin account that first sends the
# bot a private /start.
# DATABASE_PATH=spotify_radar.db
# RELEASE_LOOKBACK_DAYS=5
# MUSIC_MAX_RETRIES=3
# SPOTIFY_CHECK_DELAY_SECONDS=1.5
# SPOTIFY_MARKET=US
# IMPORT_DELAY_SECONDS=0.5
# SPOTIFY_QUOTA_COOLDOWN_SECONDS=900
# MAX_IMPORT_ARTISTS=200
# MAX_IMPORT_BYTES=1048576
# SPOTIFY_PROXY_URL=http://proxy.example.internal:8080
